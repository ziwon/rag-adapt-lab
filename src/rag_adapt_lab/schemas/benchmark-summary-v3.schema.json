{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-adapt-lab.local/schemas/benchmark-summary-v3.schema.json",
  "title": "rag-adapt-lab benchmark summary v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "configuration", "provenance",
    "retrieval_metrics", "recipes", "comparisons"
  ],
  "properties": {
    "schema_name": {"const": "benchmark-summary"},
    "schema_version": {"const": 3},
    "configuration": {
      "type": "object",
      "required": ["model", "prompt", "retriever", "scorer", "seed", "bootstrap_samples"]
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "verified", "confounded", "allow_unverified_adapter",
        "allow_unmatched_training_controls", "training_controls_matched",
        "training_control_mismatches", "warnings"
      ],
      "properties": {
        "verified": {"type": "boolean"},
        "confounded": {"type": "boolean"},
        "allow_unverified_adapter": {"type": "boolean"},
        "allow_unmatched_training_controls": {"type": "boolean"},
        "training_controls_matched": {"type": ["boolean", "null"]},
        "training_control_mismatches": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "retrieval_metrics": {"type": "object"},
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "adapter_path", "adapter_sha256", "adapter_provenance",
          "retrieval_enabled", "predictions", "metrics"
        ],
        "properties": {
          "adapter_path": {"type": ["string", "null"]},
          "adapter_sha256": {"type": ["string", "null"]},
          "adapter_provenance": {"type": ["object", "null"]},
          "retrieval_enabled": {"type": "boolean"},
          "predictions": {"type": "string"},
          "metrics": {"type": "object"}
        }
      }
    },
    "comparisons": {"type": "object"}
  }
}
