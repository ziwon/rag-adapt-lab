{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-adapt-lab.local/schemas/training-manifest-v3.schema.json",
  "title": "rag-adapt-lab training manifest v3",
  "type": "object",
  "required": [
    "schema_name", "schema_version", "adaptation_mode", "model", "training_prompt",
    "chat_template_kwargs", "training_config", "training_configuration_sha256",
    "training_controls", "training_control_sha256", "training_dataset_fingerprint",
    "validation_dataset_fingerprint", "training_source_fingerprint",
    "validation_source_fingerprint", "held_out_evaluation_sha256", "split",
    "loss_masking", "train_metrics", "validation_metrics", "adapter_path",
    "adapter_artifact_sha256"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_name": {"const": "raglab-training-manifest"},
    "schema_version": {"const": 3},
    "adaptation_mode": {"enum": ["sft", "raft"]},
    "mode": {"enum": ["sft", "raft"]},
    "model": {
      "type": "object", "required": ["model_id", "revision"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "training_prompt": {
      "type": "object", "required": ["name", "version", "template_sha256"]
    },
    "chat_template_kwargs": {"type": "object"},
    "training_config": {"type": "object"},
    "training_configuration_sha256": {"$ref": "#/$defs/digest"},
    "training_controls": {"type": "object", "minProperties": 1},
    "training_control_sha256": {"$ref": "#/$defs/digest"},
    "training_dataset_fingerprint": {"$ref": "#/$defs/digest"},
    "validation_dataset_fingerprint": {"$ref": "#/$defs/digest"},
    "training_source_fingerprint": {"$ref": "#/$defs/digest"},
    "validation_source_fingerprint": {"$ref": "#/$defs/digest"},
    "held_out_evaluation_sha256": {"$ref": "#/$defs/digest"},
    "split": {
      "type": "object",
      "required": [
        "strategy", "group_by", "group_counts", "corpus_policy",
        "partition_fingerprints", "document_overlap_count", "question_overlap_count",
        "negative_mining_scope", "seed", "train_examples", "validation_examples"
      ]
    },
    "loss_masking": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "prompt_tokens_in_loss", "trl_completion_only_loss"],
      "properties": {
        "strategy": {"const": "completion-only"},
        "prompt_tokens_in_loss": {"const": false},
        "trl_completion_only_loss": {"const": true}
      }
    },
    "train_metrics": {"type": "object"},
    "validation_metrics": {"type": "object"},
    "adapter_path": {"type": "string", "minLength": 1},
    "adapter_artifact_sha256": {"$ref": "#/$defs/digest"}
  }
}
