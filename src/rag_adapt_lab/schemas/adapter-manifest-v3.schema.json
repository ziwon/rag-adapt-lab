{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-adapt-lab.local/schemas/adapter-manifest-v3.schema.json",
  "title": "rag-adapt-lab adapter manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name", "schema_version", "model", "recipe", "adaptation_mode",
    "training_prompt", "chat_template_kwargs", "training_dataset_fingerprint",
    "validation_dataset_fingerprint", "training_source_fingerprint",
    "validation_source_fingerprint", "held_out_evaluation_sha256",
    "training_configuration_sha256", "training_controls", "training_control_sha256",
    "adapter_artifact_sha256", "best_checkpoint", "best_validation_metric"
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableNumber": {"type": ["number", "null"]},
    "nullableString": {"type": ["string", "null"]}
  },
  "properties": {
    "schema_name": {"const": "raglab-adapter-manifest"},
    "schema_version": {"const": 3},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "revision"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "recipe": {"$ref": "#/$defs/nullableString"},
    "adaptation_mode": {"enum": ["sft", "raft"]},
    "training_prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "template_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "template_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "chat_template_kwargs": {"type": "object"},
    "training_dataset_fingerprint": {"$ref": "#/$defs/digest"},
    "validation_dataset_fingerprint": {"$ref": "#/$defs/digest"},
    "training_source_fingerprint": {"$ref": "#/$defs/digest"},
    "validation_source_fingerprint": {"$ref": "#/$defs/digest"},
    "held_out_evaluation_sha256": {"$ref": "#/$defs/digest"},
    "training_configuration_sha256": {"$ref": "#/$defs/digest"},
    "training_controls": {"type": "object", "minProperties": 1},
    "training_control_sha256": {"$ref": "#/$defs/digest"},
    "adapter_artifact_sha256": {"$ref": "#/$defs/digest"},
    "best_checkpoint": {"$ref": "#/$defs/nullableString"},
    "best_validation_metric": {"$ref": "#/$defs/nullableNumber"}
  }
}
