{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-adapt-lab.local/schemas/adapter-manifest-v2.schema.json",
  "title": "rag-adapt-lab adapter manifest v2",
  "type": "object",
  "required": [
    "schema_version", "model", "adaptation_mode", "training_prompt",
    "chat_template_kwargs", "training_dataset_fingerprint",
    "validation_dataset_fingerprint", "held_out_evaluation_sha256",
    "training_configuration_sha256", "adapter_artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "model": {
      "type": "object",
      "required": ["model_id", "revision"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "adaptation_mode": {"enum": ["sft", "raft"]},
    "training_prompt": {
      "type": "object",
      "required": ["name", "version", "template_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "chat_template_kwargs": {"type": "object"},
    "training_dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "validation_dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "held_out_evaluation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "training_configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
