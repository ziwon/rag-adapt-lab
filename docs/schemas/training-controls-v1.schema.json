{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rag-adapt-lab.local/schemas/training-controls-v1.schema.json",
  "title": "rag-adapt-lab normalized training controls v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adaptation_method", "adapter", "optimization", "batching", "sequence",
    "warmup", "gradient_checkpointing", "precision", "quantization", "seeds",
    "loss", "checkpoint_selection"
  ],
  "$defs": {
    "stringMap": {
      "type": "object",
      "additionalProperties": true
    },
    "positiveIntegerMap": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "moduleList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "nullableModuleList": {
      "oneOf": [
        {"$ref": "#/$defs/moduleList"},
        {"type": "null"}
      ]
    }
  },
  "properties": {
    "adaptation_method": {"enum": ["lora", "qlora"]},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peft_type", "rank", "alpha", "dropout", "target_modules", "bias",
        "task_type", "modules_to_save", "use_rslora", "use_dora", "rank_pattern",
        "alpha_pattern", "layers_to_transform", "layers_pattern"
      ],
      "properties": {
        "peft_type": {"const": "LORA"},
        "rank": {"type": "integer", "minimum": 1},
        "alpha": {"type": "integer", "minimum": 1},
        "dropout": {"type": "number", "minimum": 0, "maximum": 1},
        "target_modules": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/moduleList"}
          ]
        },
        "bias": {"enum": ["none", "all", "lora_only"]},
        "task_type": {"const": "CAUSAL_LM"},
        "modules_to_save": {"$ref": "#/$defs/nullableModuleList"},
        "use_rslora": {"type": "boolean"},
        "use_dora": {"type": "boolean"},
        "rank_pattern": {"$ref": "#/$defs/positiveIntegerMap"},
        "alpha_pattern": {"$ref": "#/$defs/positiveIntegerMap"},
        "layers_to_transform": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0}
            },
            {"type": "null"}
          ]
        },
        "layers_pattern": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/moduleList"},
            {"type": "null"}
          ]
        }
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_rate", "optimizer", "optimizer_args", "adam_beta1", "adam_beta2",
        "adam_epsilon", "scheduler", "scheduler_kwargs", "weight_decay",
        "max_grad_norm", "num_train_epochs", "max_steps"
      ],
      "properties": {
        "learning_rate": {"type": "number", "exclusiveMinimum": 0},
        "optimizer": {"type": "string", "minLength": 1},
        "optimizer_args": {"type": "string"},
        "adam_beta1": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "adam_beta2": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "adam_epsilon": {"type": "number", "exclusiveMinimum": 0},
        "scheduler": {"type": "string", "minLength": 1},
        "scheduler_kwargs": {"$ref": "#/$defs/stringMap"},
        "weight_decay": {"type": "number", "minimum": 0},
        "max_grad_norm": {"type": "number", "minimum": 0},
        "num_train_epochs": {"type": "number", "exclusiveMinimum": 0},
        "max_steps": {
          "anyOf": [
            {"const": -1},
            {"type": "integer", "minimum": 1}
          ]
        }
      }
    },
    "batching": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_device_train_batch_size", "per_device_eval_batch_size",
        "gradient_accumulation_steps", "effective_batch_size_per_device",
        "effective_batch_size"
      ],
      "properties": {
        "per_device_train_batch_size": {"type": "integer", "minimum": 1},
        "per_device_eval_batch_size": {"type": "integer", "minimum": 1},
        "gradient_accumulation_steps": {"type": "integer", "minimum": 1},
        "effective_batch_size_per_device": {"type": "integer", "minimum": 1},
        "effective_batch_size": {"type": "integer", "minimum": 1}
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_length"],
      "properties": {"max_length": {"type": "integer", "minimum": 1}}
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ratio", "steps"],
      "properties": {
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "steps": {"type": "integer", "minimum": 0}
      }
    },
    "gradient_checkpointing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "kwargs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "kwargs": {"$ref": "#/$defs/stringMap"}
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bf16", "fp16", "tf32"],
      "properties": {
        "bf16": {"type": "boolean"},
        "fp16": {"type": "boolean"},
        "tf32": {"type": "boolean"}
      }
    },
    "quantization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_in_4bit", "type", "double_quantization", "compute_dtype"],
      "properties": {
        "load_in_4bit": {"type": "boolean"},
        "type": {"enum": ["nf4", "fp4", null]},
        "double_quantization": {"type": ["boolean", "null"]},
        "compute_dtype": {"enum": ["bfloat16", "float16", "float32", null]}
      },
      "allOf": [
        {
          "if": {"properties": {"load_in_4bit": {"const": true}}},
          "then": {
            "properties": {
              "type": {"enum": ["nf4", "fp4"]},
              "double_quantization": {"type": "boolean"},
              "compute_dtype": {"enum": ["bfloat16", "float16", "float32"]}
            }
          },
          "else": {
            "properties": {
              "type": {"type": "null"},
              "double_quantization": {"type": "null"},
              "compute_dtype": {"type": "null"}
            }
          }
        }
      ]
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training", "data"],
      "properties": {
        "training": {"type": "integer", "minimum": 0},
        "data": {"type": "integer", "minimum": 0}
      }
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completion_only", "label_smoothing_factor"],
      "properties": {
        "completion_only": {"const": true},
        "label_smoothing_factor": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "checkpoint_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_enabled", "evaluation_strategy", "evaluation_steps", "save_strategy",
        "save_steps", "save_total_limit", "load_best_model_at_end",
        "metric_for_best_model", "greater_is_better", "early_stopping_metric",
        "early_stopping_patience", "early_stopping_threshold",
        "best_model_selection_policy"
      ],
      "properties": {
        "validation_enabled": {"type": "boolean"},
        "evaluation_strategy": {"enum": ["no", "steps", "epoch"]},
        "evaluation_steps": {"type": ["integer", "null"], "minimum": 1},
        "save_strategy": {"enum": ["no", "steps", "epoch"]},
        "save_steps": {"type": "integer", "minimum": 1},
        "save_total_limit": {"type": "integer", "minimum": 1},
        "load_best_model_at_end": {"type": "boolean"},
        "metric_for_best_model": {"type": ["string", "null"]},
        "greater_is_better": {"type": ["boolean", "null"]},
        "early_stopping_metric": {"type": ["string", "null"]},
        "early_stopping_patience": {"type": "integer", "minimum": 0},
        "early_stopping_threshold": {"type": "number", "minimum": 0},
        "best_model_selection_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["load_best_model_at_end", "metric", "greater_is_better"],
          "properties": {
            "load_best_model_at_end": {"type": "boolean"},
            "metric": {"type": ["string", "null"]},
            "greater_is_better": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  }
}
